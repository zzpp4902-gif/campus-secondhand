# Supabase 项目 URL（Project Settings → API → Project URL）
SUPABASE_URL=https://your-project.supabase.co
# Supabase anon public key（Project Settings → API → anon public）
SUPABASE_KEY=your-supabase-anon-key
# PostgreSQL 连接串（Supabase Project Settings → Database → Connection string → URI）
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Flask 会话密钥（任意随机字符串）
SECRET_KEY=campus-secondhand-secret-2026
